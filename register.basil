                Confirm password
                <input type="password" name="confirm" autocomplete="new-password" required placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢" />
              </label>
            </div>

            <label style="display: flex; align-items: start; gap: 10px; font-weight: 700;">
